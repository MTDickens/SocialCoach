# Local values for `pnpm cf:preview`. Copy to .dev.vars (git-ignored). Never put production secrets here.
NEXTJS_ENV=production
ACCOUNT_SECRET=replace-with-at-least-32-random-characters-000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APP_ORIGIN=http://127.0.0.1:8787
AUTH_ALLOWED_LOGINS=your-github-login
